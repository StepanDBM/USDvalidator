#usda 1.0
(
    defaultPrim = "World"
    startTimeCode = 1
    endTimeCode = 96
    framesPerSecond = 24
    timeCodesPerSecond = 24
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    def Mesh "Body"
    {
        uniform token subdivisionScheme = "catmullClark"
        point3f[] points = [(-2, -1, 0), (2, -1, 0), (2, 1, 0), (-2, 1, 0), (0, 2, 0)]
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 4, 1, 2, 4]
    }

    def Xform "NewProp"
    {
        double3 xformOp:translate.timeSamples = {
            1: (0, 0, 0),
            96: (10, 0, 0)
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
