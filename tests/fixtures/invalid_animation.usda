#usda 1.0

(
    defaultPrim = "World"
    startTimeCode = 120
    endTimeCode = 1
    framesPerSecond = 24
    timeCodesPerSecond = 24
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    def Xform "AnimatedObject"
    {
        double3 xformOp:translate.timeSamples = {
            1:   (0, 0, 0),
            60:  (2, 0, 0),
            120: (4, 0, 0)
        }

        uniform token[] xformOpOrder = [
            "xformOp:translate"
        ]
    }

    def Mesh "Mesh"
    {
        point3f[] points = [
            (-1, -1, 0),
            ( 1, -1, 0),
            ( 1,  1, 0),
            (-1,  1, 0)
        ]

        int[] faceVertexCounts = [4]

        int[] faceVertexIndices = [
            0, 1, 2, 3
        ]
    }

    def Camera "Camera"
    {
        float focalLength = 50
    }

    def DistantLight "KeyLight"
    {
        float intensity = 1000
    }
}