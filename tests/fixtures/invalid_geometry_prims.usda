#usda 1.0

(
    defaultPrim = "World"
    endTimeCode = 120
    framesPerSecond = 24
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    def Mesh "BrokenMesh"
    {
        point3f[] points = [
            (0, 0, 0),
            (1, 0, 0),
            (1, 1, 0)
        ]

        # Three vertices but a face requiring four indices.
        int[] faceVertexCounts = [4]

        int[] faceVertexIndices = [
            0, 1, 2, 99
        ]
    }

    def Xform "AnimatedObject"
    {
        double3 xformOp:translate.timeSamples = {
            1:   (0, 0, 0),
            60:  (2, 0, 0),
            120: (4, 0, 0)
        }

        uniform token[] xformOpOrder = [
            "xformOp:translate"
        ]
    }

    def Camera "Camera"
    {
        float focalLength = 50
    }

    def DistantLight "KeyLight"
    {
        float intensity = 1000
    }
}