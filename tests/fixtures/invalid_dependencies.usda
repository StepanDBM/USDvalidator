#usda 1.0

(
    defaultPrim = "World"
    endTimeCode = 120
    framesPerSecond = 24
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    def Xform "ValidObject"
    {
        def Mesh "Mesh"
        {
            point3f[] points = [
                (-1, -1, 0),
                ( 1, -1, 0),
                ( 1,  1, 0),
                (-1,  1, 0)
            ]

            int[] faceVertexCounts = [4]

            int[] faceVertexIndices = [
                0, 1, 2, 3
            ]
        }
    }

    def Xform "BrokenReference"
    (
        references = @this_file_does_not_exist.usda@
    )
    {
    }

    def Xform "BrokenPayload"
    (
        payload = @this_payload_does_not_exist.usda@
    )
    {
    }

    def Camera "Camera"
    {
        float focalLength = 50
    }

    def DistantLight "KeyLight"
    {
        float intensity = 1000
    }
}