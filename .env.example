# Local service defaults. Copy to .env only when overriding repository defaults.
S_USDV_SERVICE_NAME=S-USDv Service
S_USDV_SERVICE_VERSION=0.3.0
S_USDV_API_PREFIX=/api/v1
S_USDV_DATA_ROOT=.s_usdv_data
S_USDV_DATABASE_URL=sqlite:///./.s_usdv_data/s_usdv.db
S_USDV_STORAGE_ROOT=.s_usdv_data/storage
S_USDV_TEMPORARY_ROOT=.s_usdv_data/temp

# Optional full OpenUSD runtime used by the desktop viewport.
# S_USDV_OPENUSD_ROOT=E:/path/to/OpenUSD/Setup
